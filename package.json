{
  "name": "gamehub",
  "version": "1.0.0",
  "description": "A self-hosted real-time browser game platform.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js dist/game-sdk/*.test.js dist/games/egyptianWar/*.test.js test/*.test.js",
    "start": "node dist/server.js"
  },
  "keywords": [
    "browser-game",
    "socket.io",
    "typescript"
  ],
  "author": "Mason Fong",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
