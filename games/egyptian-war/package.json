{
  "name": "@gamehub/egyptian-war",
  "version": "1.0.0",
  "description": "Egyptian War game plugin for GameHub.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "public"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/*.test.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@gamehub/game-sdk": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
